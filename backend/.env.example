# ==========================================================================
#  Variabilele de mediu ale backend-ului
# ==========================================================================
#  In Docker NU aveti nevoie de acest fisier: valorile vin din .env-ul din
#  folderul principal, prin compose.yaml.
#  Daca rulati backend-ul direct pe calculator (fara Docker), copiati
#  fisierul in backend/.env si adaptati valorile. backend/.env este in .gitignore.

# Conexiunea la PostgreSQL (driverul psycopg 3)
DATABASE_URL=postgresql+psycopg://isia:isia@localhost:5432/isia

# Adresa serverului Ollama si modelul folosit
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b

# Adresele frontend-ului care au voie sa apeleze API-ul (separate prin virgula)
CORS_ORIGINS=http://localhost:5173
