# ==========================================================================
#  Configurarea proiectului, citita de docker compose (compose.yaml)
# ==========================================================================
#  Valori pentru lucrul pe calculatorul vostru; nu contin date secrete.
#  Dupa o modificare, rulati din folderul principal: docker compose up -d

# --- Baza de date PostgreSQL ---
POSTGRES_DB=isia
POSTGRES_USER=isia
POSTGRES_PASSWORD=isia

# --- Porturile de pe calculatorul vostru ---
# Daca un port este ocupat (de exemplu de alt proiect), schimbati-l aici.
POSTGRES_PORT=5432
BACKEND_PORT=8000
FRONTEND_PORT=5173

# --- Ollama (ruleaza pe calculator, nu in Docker) ---
# host.docker.internal = calculatorul vostru, vazut din container
OLLAMA_URL=http://host.docker.internal:11434
# Modelul folosit; vedeti modelele descarcate cu: ollama list
OLLAMA_MODEL=qwen2.5:1.5b
