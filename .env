# ==============================================================================
# CONFIGURARE BAZA DE DATE (PostgreSQL existent din containerul postgres_db)
# ==============================================================================
POSTGRES_DB=isia
POSTGRES_USER=isia
POSTGRES_PASSWORD=isia
POSTGRES_PORT=5432

# ==============================================================================
# PORTURI APLICATIE (Evitam 8000 ocupat de web_sedinte)
# ==============================================================================
BACKEND_PORT=8010
FRONTEND_PORT=5173

# ==============================================================================
# INTEGRARE OLLAMA (Containerul local ollama_ai)
# ==============================================================================
# Folosim puntea Docker interna pentru a comunica direct cu serverul gazda
OLLAMA_URL=http://host.docker.internal:11434
# Modelul implicit de pornire (dintre cele instalate deja pe server)
OLLAMA_MODEL=qwen2.5:3b

# ==============================================================================
# PUBLICARE PRIN NGINX PROXY MANAGER
# ==============================================================================
# Domeniul configurat in Nginx Proxy Manager (Proxy Host -> 192.168.1.254:5173)
PUBLIC_HOST=echipa.asociatiamb.ro
# Lasati gol: browserul apeleaza /api pe acelasi domeniu. Completati doar daca expuneti backend-ul separat.
VITE_API_URL=
